# Optional: leave all values blank for a fully local-only build.
# Copy this to .env.local and fill in Firebase's PUBLIC web-app config.
# Never put service-account credentials, private keys, or admin tokens here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
